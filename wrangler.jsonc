{
  // Only needed if you deploy from the command line (npx wrangler deploy).
  // Dashboard deploys do not use this file.
  //
  // This is a template with placeholders. Real deployment values (KV
  // namespace id, ALLOW_ORIGIN) belong in wrangler.local.jsonc, which is
  // gitignored and stays out of the repo. Deploy with:
  //   npx wrangler deploy --config wrangler.local.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal-tiles",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "vars": {
    "ALLOW_ORIGIN": "https://<your-page-origin>,http://localhost:3000,http://localhost:5173"
  },
  "kv_namespaces": [
    { "binding": "TILES", "id": "<KV_NAMESPACE_ID>" }
  ]
}